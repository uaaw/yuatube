        <% if (videoData.streamUrls && videoData.streamUrls.length > 0) { %>
        <div style="margin-bottom:12px;">
            <label style="display:block;color:#b9bbbe;font-size:0.85rem;margin-bottom:6px;">画質選択:
                <select id="qualitySelect" style="width:100%;margin-top:4px;">
                    <% videoData.streamUrls.forEach(stream => { %>
                    <option value="<%= stream.url %>" data-resolution="<%= stream.resolution %>"><%= stream.resolution %></option>
                    <% }); %>
                </select>
            </label>
            <button id="qualityReset" style="width:100%;padding:8px;">画質をリセット</button>
        </div>
        <% } else { %>
        <p style="color:#72767d;font-size:0.85rem;margin-bottom:8px;">他の画質が見つかりません</p>
        <% } %>
        <p style="color:#b9bbbe;font-size:0.85rem;">使用サーバー: <strong style="color:#fff;"><%= baseUrl %></strong></p>
    </div>
    <div id="settingsTab" class="tab-content" style="display:none;">
        <h2 style="font-size:1rem;font-weight:700;margin-bottom:8px;">再生方法の変更</h2>
        <p style="color:#b9bbbe;font-size:0.85rem;margin-bottom:12px;">現在の再生方法: 通常</p>
        <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">
            <label style="display:flex;align-items:flex-start;gap:8px;font-size:0.875rem;cursor:pointer;">
                <input type="radio" name="playbackMode" value="normal" checked style="margin-top:3px;accent-color:#5865F2;">
                <div><strong style="color:#fff;">通常</strong><p style="color:#72767d;font-size:0.8rem;">ストリームURLを用いて再生します。</p></div>
            </label>
            <label style="display:flex;align-items:flex-start;gap:8px;font-size:0.875rem;cursor:pointer;">
                <input type="radio" name="playbackMode" value="nocookie" style="margin-top:3px;accent-color:#5865F2;">
                <div>
                    <strong style="color:#fff;">nocookie</strong>
                    <p style="color:#72767d;font-size:0.8rem;">youtube-nocookieを埋め込んで再生します。
                        <a href="/gen/yt/nocookie/<%= videoId %>" target="_blank" style="color:#7289DA;">確認する</a>
                    </p>
                </div>
            </label>
            <label style="display:flex;align-items:flex-start;gap:8px;font-size:0.875rem;cursor:pointer;">
                <input type="radio" name="playbackMode" value="invidious" style="margin-top:3px;accent-color:#5865F2;">
                <div>
                    <strong style="color:#fff;">invidious</strong>
                    <p style="color:#72767d;font-size:0.8rem;">Invidiousサーバーを経由して再生します。
                        <a href="/gen/yt/invidious/<%= videoId %>" target="_blank" style="color:#7289DA;">確認する</a>
                    </p>

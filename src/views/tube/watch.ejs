<div id="controlPanel" class="controlPanel" style="background:rgba(14,14,14,0.96);border:1px solid rgba(88,101,242,0.25);backdrop-filter:blur(12px);color:#fff;padding:24px;border-radius:12px;width:360px;position:fixed;bottom:40px;right:40px;">

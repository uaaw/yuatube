        <button id="saveSettings" style="width:100%;padding:10px;">設定を保存</button>
    </div>
</div>

        <div class="sidebar w-1/4 ml-4" id="sidebar">
            <button id="toggleControlPanel" class="w-full bg-gray-700 py-2 rounded">コントロール</button>
            <div class="mt-4">
<% if (videoInfo.watch_next_feed && videoInfo.watch_next_feed.length > 0) { %>
<div class="mt-2 space-y-2">
  <% let hasValidVideo = false; %>
  <% videoInfo.watch_next_feed.forEach(video => { %>
    <% if (!video || !video.type) return; %>
    <% if (video.type.endsWith("Video")) { %>
      <% hasValidVideo = true; %>
      <div class="bg-gray-800 p-2 rounded result-item">
        <a href="/gen/watch/<%= video.id %>">
          <img src="/gen/back/vi/<%= video.id %>/mqdefault.jpg" alt="<%= video.title.text %> のサムネイル" class="w-full h-auto rounded">
        </a>
        <div class="flex items-center mt-2">
          <% if (video.author?.thumbnails.length) { %>
            <a href="/gen/c/<%= video.author.id %>">
              <img src="/gen/back/yt3<%- (new URL(video.author.thumbnails[0].url)).pathname %>" alt="<%= video.author.name %> のアイコン" class="w-6 h-6 rounded-full">
            </a>
          <% } %>
          <p class="text-sm text-gray-400 ml-2">
              <a href="/gen/c/<%= video.author.id %>"><%= video.author.name %></a>
          </p>
        </div>
        <p class="text-sm font-bold mt-1">
          <%= video.title.text %>
        </p>
        <p class="text-xs text-gray-400">
          <%= video.short_view_count?.text || video.view_count?.text || '不明' %>
        </p>
      </div>
    <% } else if (video.type.endsWith("Playlist")) { %>
      <% hasValidVideo = true; %>
      <div class="bg-gray-800 p-2 rounded">
        <a href="/gen/p/<%= video.id %>">
          <img src="/gen/back/vi/<%= video?.endpoint?.payload?.videoId || video.first_videos?.[0]?.id || 'default' %>/mqdefault.jpg" alt="<%= video.title.text %> のサムネイル" class="w-full h-24 rounded">
        </a>
        <p class="text-sm font-bold mt-1">
          <a href="/gen/p/<%= video.id %>"><%= video.title.text %></a>
        </p>
        <p class="text-xs text-gray-400">動画数: <%= video.video_count?.text || '不明' %></p>
      </div>
    <% } else if (video.type.endsWith("Channel")) { %>
      <% hasValidVideo = true; %>
      <div class="bg-gray-800 p-2 rounded">
        <a href="/gen/c/<%= video.author.id %>">
          <% if (video.author?.thumbnails?.[0]?.url) { %>
          <img src="/gen/back/yt3<%- (new URL(video.author.thumbnails[0].url)).pathname %>" alt="<%= video.author.name %> のチャンネルアイコン" class="w-16 h-16 rounded-full mx-auto">
          <% } %>
        </a>
        <p class="text-sm font-bold mt-1 text-center">
          <a href="/gen/c/<%= video.author.id %>"><%= video.author.name %></a>
        </p>
        <p class="text-xs text-gray-400 text-center">
          登録者数: <%= video.subscriber_count?.text || '非公開' %>
        </p>
      </div>
    <% } %>
  <% }); %>
</div>
<% if (!hasValidVideo) { %>
    <div style="height: 100vh; width: 100%;">
        <iframe src="/gen/back/next/<%= videoId %>" width="100%" height="100%" frameborder="0" allowfullscreen></iframe>
    </div>
<% } %>
<% } else { %>
<div style="height: 100vh; width: 100%;">
    <iframe src="/gen/back/next/<%= videoId %>" width="100%" height="100%" frameborder="0" allowfullscreen></iframe>
</div>
<% } %>
            </div>
        </div>
    </div>
              
<script>
// コメント
const retryButton = document.getElementById("retryButton");

async function fetchComments() {
    document.getElementById("commentsList2").innerHTML = "<p>コメントを取得中...</p>";
    document.getElementById("commentError2").style.display = "none";
    retryButton.style.display = "none";

    try {
        const response = await fetch("/gen/back/comment/<%= videoId %>");
        if (!response.ok) throw new Error("サーバーエラー");
        document.getElementById("commentsList2").innerHTML = await response.text();
    } catch (error) {
        console.error("エラー:", error);
        showerrorMessage("コメントの取得に失敗しました");
        document.getElementById("commentError2").textContent = "コメントの取得に失敗したわ: " + error.message;
        document.getElementById("commentError2").style.display = "block";
        retryButton.style.display = "block";
    }
}

document.getElementById("retryButton").addEventListener("click", fetchComments);
fetchComments();
  
//ループ
const loopToggle = document.getElementById('loopToggle');
const video = document.getElementById('video');
const isLoop = localStorage.getItem('videoLoop') === 'true';
loopToggle.checked = isLoop;
video.loop = isLoop;
loopToggle.addEventListener('change', function() {
    video.loop = this.checked;
    localStorage.setItem('videoLoop', this.checked);
});
  
//動画再読み込み
document.getElementById('reloadButton').addEventListener('click', function() {
  video.load();
});
document.getElementById('reloadVideo').addEventListener('click', function() {
  video.load();
});
  
//エラー処理
video.addEventListener('error', function() {
    showerrorMessage(`動画の読み込みに失敗したわ: ${error}`);
    let lastCurrentTime = video.currentTime;
    video.load();
    video.addEventListener('loadedmetadata', function() {
        video.currentTime = lastCurrentTime;
        video.play();
    }, { once: true });
});

const erroreloadButton = document.getElementById("erroreloadButton");

let readyZeroStart = null;
let readyZerodone = false;
setInterval(() => {
  if (video.readyState === 0 && !readyZerodone) {
    if (!readyZeroStart) {
      readyZeroStart = Date.now();
    } else if (Date.now() - readyZeroStart > 3000) {
      showerrorMessage('動画読み込みエラー。');
      erroreloadButton.classList.remove("hidden");
      video.load();
      readyZerodone = true;
      readyZeroStart = null;
    }
  } else {
    readyZeroStart = null;
  }
}, 1000);
erroreloadButton.addEventListener("click", () => {
  erroreloadButton.classList.add("hidden");
  readyZerodone = false;
  video.load();
  video.play().catch(err => {
    console.warn("再生に失敗しました:", err);
  });
});
video.addEventListener("canplay", () => {
  erroreloadButton.classList.add("hidden");
  readyZerodone = false;
});

document.addEventListener('DOMContentLoaded', function () {
    const loadingIndicator = document.querySelector('.loading-indicator');
    const showLoadingIndicator = () => {
        loadingIndicator.style.display = 'block';
    };
    const hideLoadingIndicator = () => {
        loadingIndicator.style.display = 'none';
    };
    video.addEventListener('waiting', showLoadingIndicator);
    video.addEventListener('playing', hideLoadingIndicator);
    video.addEventListener('canplay', hideLoadingIndicator);
    video.addEventListener('seeked', () => {
        if (video.readyState < 3) {
            showLoadingIndicator();
        } else {
            hideLoadingIndicator();
        }
    });
    video.addEventListener('error', () => {
        console.error('動画の再生中にエラーが発生した:', video.error);
    });
});

//けんさく
const searchBox = document.getElementById('searchbox');
const clearBtn = document.getElementById('clearBtn');
function toggleClearButton() {
    clearBtn.style.display = searchBox.value ? 'block' : 'none';
}
searchBox.addEventListener('input', toggleClearButton);
clearBtn.addEventListener('click', () => {
   searchBox.value = '';
   searchBox.focus();
   toggleClearButton();
});

// コントロール
$(document).ready(function() {
    $('#toggleControlPanel').click(() =>$('#controlPanel').toggleClass('open'));
    $('#closeControlPanel').click(() => $('#controlPanel').toggleClass('open'));

    $('.tab-button').click(function() {
        $('.tab-button').removeClass('active');
        $(this).addClass('active');
        $('.tab-content').removeClass('active');
        $('#' + $(this).data('target')).addClass('active');
    });

    $('#qualitySelect').change(function() {
        const selectedOption = $(this).find(':selected');
        const resolution = selectedOption.attr('data-resolution');

        videoSrc.type = "video/webm";
        videoSrc.src = selectedOption.val();
        audio.src = "<%- videoData.stream_url %>";
        $('#controlPanel').toggleClass('open');
        video.load();
        audio.load();

        video.addEventListener('loadedmetadata', () => {
            video.play().catch(error => console.error("動画の再生エラー:", error));
        });

        video.addEventListener('play', () => {
            audio.play().catch(error => console.error("オーディオの再生エラー:", error));
        });

        video.addEventListener('pause', () => {
            audio.pause();
            audio.currentTime = video.currentTime;
        });

        video.addEventListener('ended', () => {
            audio.pause();
            audio.currentTime = 0;
        });

        video.addEventListener('seeked', () => {
            video.pause();
            audio.pause();
            audio.currentTime = video.currentTime;
            audio.play();
            video.play();
        });

        video.addEventListener('timeupdate', () => {
            if (Math.abs(video.currentTime - audio.currentTime) > 0.4) {
                audio.currentTime = video.currentTime + 0.1;
            }
        });
    });
  
    $('#qualityReset').click(function() {
        const audio = document.getElementById('audio');
        const videoSrc = document.getElementById('videoSrc');

        videoSrc.type = "video/mp4";
        videoSrc.src = "<%- videoData.stream_url %>";
        audio.src = "";
        $('#controlPanel').toggleClass('open');
        video.load();
    });


    $('#saveSettings').click(function() {
        $('#controlPanel').toggleClass('open');
        const mode = $('input[name="playbackMode"]:checked').val();
        document.cookie = `playbackMode=${mode}; path=/; max-age=31536000`;
        showMessage(`再生方法を${mode}に変更するわ`);
        const params = new URLSearchParams(window.location.search);
        const playlist = params.get('playlist');
        let url = `/gen/redirect/mode/<%= videoId %>?mode=${mode}`;
        if (playlist) url += `&playlist=${encodeURIComponent(playlist)}`;
        window.location.href = url;
    });
});

// ツールバー
$('#toggleToolbar').click(() => $('#toolbar').addClass('open'));
$('#closeToolbar').click(() => $('#toolbar').removeClass('open'));

// 高画質
$('#hdToggle').change(function() {
    const audio = document.getElementById('audio');
    const videoSrc = document.getElementById('videoSrc');

    if (this.checked) {
        videoSrc.type = "video/webm";
        videoSrc.src = "<%- videoData.highstreamUrl %>";
        audio.src = "<%- videoData.stream_url %>";
        video.load();
        audio.load();

        video.addEventListener('loadedmetadata', () => {
            video.play().catch(error => console.error("動画の再生エラー:", error));
        });

        video.addEventListener('play', () => {
            audio.play().catch(error => console.error("オーディオの再生エラー:", error));
        });

        video.addEventListener('pause', () => {
            audio.pause();
            audio.currentTime = video.currentTime;
        });

        video.addEventListener('ended', () => {
            audio.pause();
            audio.currentTime = 0;
        });

        video.addEventListener('seeked', () => {
            video.pause();
            audio.pause();
            audio.currentTime = video.currentTime;
            video.play();
            audio.play();
        });

        video.addEventListener('timeupdate', () => {
            if (Math.abs(video.currentTime - audio.currentTime) > 0.4) {
                audio.currentTime = video.currentTime + 0.1;
            }
        });
    } else {
        videoSrc.type = "video/mp4";
        videoSrc.src = "<%- videoData.stream_url %>";
        audio.pause();
        audio.src = '';
        video.load();
        video.play().catch(error => console.error("動画の再生エラー:", error));
    }
});
  
//wakelock
let wakeLock = null;
async function requestWakeLock() {
    try {
        if (!wakeLock) {
            wakeLock = await navigator.wakeLock.request('screen');
            wakeLock.addEventListener('release', () => {
               wakeLock = null;
            });
        }
    } catch (err) {
        console.error(`${err.name}, ${err.message}`);
    }
}
video.addEventListener('play', async () => {
    await requestWakeLock();
});
video.addEventListener('pause', () => {
    if (wakeLock) {
        wakeLock.release().then(() => {
            wakeLock = null;
        });
    }
});
video.addEventListener('ended', () => {
    if (wakeLock) {
        wakeLock.release().then(() => {
            wakeLock = null;
        });
    }
});
  
// 履歴
const videoId = "<%= videoId %>";
const channelId = "<%= videoInfo.channelId %>";
const channelName = "<%= videoInfo.channelName %>";
const videoTitle = "<%= videoInfo.title %>";

function saveToHistory(videoId, channelId, channelName, videoTitle) {
    let history = getHistoryFromLocalStorage();
    const historyIndex = history.findIndex(track => track.videoId === videoId);
    if (historyIndex !== -1) {
        history.splice(historyIndex, 1);
    }
    if (history.length >= 30) {
        history.shift();
    }
    history.push({ videoId, channelId, channelName, videoTitle });
    localStorage.setItem("tensaitubehistory", JSON.stringify(history));
}

function getHistoryFromLocalStorage() {
    const historyData = localStorage.getItem("tensaitubehistory");
    try {
        return historyData ? JSON.parse(historyData) : [];
    } catch (error) {
        console.error('Error parsing history from localStorage:', error);
        return [];
    }
}
  
//お気に入り
function getFavoritesFromLocalStorage() {
  return JSON.parse(localStorage.getItem("tensaitubefavorites") || "[]");
}
function saveToFavorites(videoId, channelId, channelName, videoTitle) {
  let favorites = getFavoritesFromLocalStorage();
  const favIcon = document.getElementById("favoriteIcon");
  const favIndex = favorites.findIndex(track => track.videoId === videoId);
  if (favIndex !== -1) {
    favorites.splice(favIndex, 1);
    showMessage(`${videoTitle}の<a href="/gen/cl/fav" style='color: #60a5fa;'>お気に入り</a>を解除したわ`);
  } else {
    favorites.push({ videoId, channelId, channelName, videoTitle });
    showMessage(`${videoTitle}を<a href="/gen/cl/fav" style='color: #60a5fa;'>お気に入り</a>に追加したわ`);
  }
  localStorage.setItem("tensaitubefavorites", JSON.stringify(favorites));
}
async function checkfav() {
  const favBtn = document.getElementById("favoriteBtn");
  const favIcon = document.getElementById("favoriteIcon");
  let favorites = getFavoritesFromLocalStorage();
  let isFavorited;
  if(favorites){
    isFavorited = favorites.some(track => track.videoId === videoId);
  }
  favIcon.src = isFavorited ? "/img/favorite.jpg" : "/img/nofavorite.jpg";
}
checkfav()
document.getElementById("favoriteBtn").addEventListener("click", function() {
  saveToFavorites(videoId, channelId, channelName, videoTitle);
  const favIcon = document.getElementById("favoriteIcon");
  let updatedFavorites = getFavoritesFromLocalStorage();
  let nowFavorited;
  if(updatedFavorites){
    nowFavorited = updatedFavorites.some(track => track.videoId === videoId);
  }
  favIcon.src = nowFavorited ? "/img/favorite.jpg" : "/img/nofavorite.jpg";
});
  
// 概要
function toggleDescription(button) {
    const description = button.closest('div').nextElementSibling;

    if (description.classList.contains('hidden')) {
        description.classList.remove('hidden');
        button.textContent = '折りたたむ';
    } else {
        description.classList.add('hidden');
        button.textContent = '表示する';
    }
}
  
//ショトカ
document.addEventListener('keydown', function(event) {
    const activeElement = document.activeElement;
    if (activeElement.tagName === 'INPUT' || activeElement.tagName === 'TEXTAREA') {
        return;
    }
    if (event.code === 'Space') {
        event.preventDefault();
        if (video.paused) {
            video.play();
        } else {
            video.pause();
        }
    }
    if (event.key === 'f' || event.key === 'F') {
        event.preventDefault();
        toggleFullScreen();
    }
    if (event.key === 'ArrowRight') {
        video.currentTime += 10;
    } 
    if (event.key === 'ArrowLeft') {
        video.currentTime -= 10;
    }
});
function toggleFullScreen() {
    if (!document.fullscreenElement) {
        if (video.requestFullscreen) {
            video.requestFullscreen();
        } else if (video.mozRequestFullScreen) {
            video.mozRequestFullScreen();
        } else if (video.webkitRequestFullscreen) {
            video.webkitRequestFullscreen();
        } else if (video.msRequestFullscreen) {
            video.msRequestFullscreen();
        }
    } else {
        if (document.exitFullscreen) {
            document.exitFullscreen();
        } else if (document.mozCancelFullScreen) {
            document.mozCancelFullScreen();
        } else if (document.webkitExitFullscreen) {
            document.webkitExitFullscreen();
        } else if (document.msExitFullscreen) {
            document.msExitFullscreen();
        }
    }
}
  

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= serviceInfo.name %></title>
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="/css/page.css">
</head>
<body class="bg-gray-900 text-white">
    <header class="bg-gray-800 p-4 flex justify-between items-center">
        <a href="/sonota" class="text-gray-300 hover:text-white">← その他</a>
        <h1 class="text-xl font-bold"><%= serviceInfo.name %></h1>
        <div></div>
    </header>

    <div class="flex flex-col items-center justify-center min-h-[70vh] gap-6 p-6">
        <h2 class="text-2xl font-semibold">表示方法を選んでください</h2>
        <div class="flex gap-6">
            <a href="/sonota/<%= service %>/umekomi"
               class="bg-blue-600 hover:bg-blue-500 text-white text-lg font-bold py-6 px-12 rounded-xl transition">
                埋め込み
            </a>
            <% if (serviceInfo.hasSearch) { %>
            <a href="/sonota/<%= service %>/search"
               class="bg-gray-700 hover:bg-gray-600 text-white text-lg font-bold py-6 px-12 rounded-xl transition">
                検索
            </a>
            <% } %>
            <% if (serviceInfo.hasOther) { %>
            <a href="/sonota/<%= service %>/other"
               class="bg-gray-700 hover:bg-gray-600 text-white text-lg font-bold py-6 px-12 rounded-xl transition">
                その他
            </a>
            <% } %>
        </div>
    </div>
</body>
</html>

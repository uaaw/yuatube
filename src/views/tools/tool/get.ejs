<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HTML proxy</title>
  <script src="/js/tailwindcss.js"></script>
  <link rel="stylesheet" href="/css/page.css">
</head>
<body class="bg-gray-900 text-white min-h-screen flex items-center justify-center">
  <div style="width:100%;max-width:480px;padding:32px;background:rgba(20,20,20,0.95);border:1px solid rgba(88,101,242,0.2);border-radius:16px;">
    <div class="text-center">
      <h1 style="font-size:2rem;font-weight:700;color:#fff;margin-bottom:12px;">HTML proxy</h1>
      <p style="color:#b9bbbe;font-size:0.9rem;margin-bottom:24px;">ウェブサイトのHTMLを取得して確認できます。</p>
      <input type="url" id="searchBar" placeholder="URLを入力" style="width:100%;margin-bottom:16px;">
      <button id="redirectButton" style="width:100%;padding:12px;">URLを取得</button>
      <p style="margin-top:16px;font-size:0.8rem;color:#72767d;">サイトによってはUIが崩れることがあります</p>
    </div>
  </div>

  <script>
    document.getElementById('redirectButton').addEventListener('click', () => {
      const url = document.getElementById('searchBar').value.trim();
      if (!url) {
        alert('URLを入力してください');
        return;
      }
      window.location.href = `/tools/html/get/${encodeURIComponent(url)}`;
    });
  </script>
</body>
</html>
